{
  "uid": "inferobs-llm-serving",
  "title": "LLM serving: caller vs engine",
  "tags": [
    "llm",
    "inference",
    "inferobs"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "provider",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "label": "provider",
        "query": {
          "query": "label_values(gen_ai_client_operation_duration_seconds_count, gen_ai_provider_name)",
          "refId": "p"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "label": "model",
        "query": {
          "query": "label_values(gen_ai_client_operation_duration_seconds_count{gen_ai_provider_name=~\"$provider\"}, gen_ai_request_model)",
          "refId": "m"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Paging alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\", severity=\"page\"}",
        "titleFormat": "{{alertname}} {{slo}}",
        "step": "15s"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Caller experience (measured at the proxy)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests/s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(gen_ai_client_operation_duration_seconds_count{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A",
          "exemplar": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error ratio",
      "description": "Failed / all requests, client cancellations excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(gen_ai_client_operation_duration_seconds_count{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\", error_type!~\"|cancelled\"}[$__rate_interval])) or vector(0)) / sum(rate(gen_ai_client_operation_duration_seconds_count{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\", error_type!=\"cancelled\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A",
          "exemplar": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.005
              },
              {
                "color": "red",
                "value": 0.02
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "TTFC p99",
