    {
      "id": 8,
      "type": "timeseries",
      "title": "Requests/s by outcome",
      "description": "error_type is empty for success, an HTTP status for upstream errors, or timeout / connection_error / stream_interrupted / cancelled.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(sum by (error_type) (rate(gen_ai_client_operation_duration_seconds_count{gen_ai_provider_name=~\"$provider\", gen_ai_request_model=~\"$model\"}[$__rate_interval])), \"error_type\", \"ok\", \"error_type\", \"^$\")",
          "legendFormat": "{{error_type}}",
          "refId": "A",
          "exemplar": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
